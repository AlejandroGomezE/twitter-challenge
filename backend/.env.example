# Optional Observability tool (free) generate credentials at: https://www.observe.nestjs.com/
#OBSERVE_APP_KEY
#OBSERVE_APP_SECRET

PORT=

# Postgres connection string used by Prisma (prisma7.config.ts). No database is
# provisioned yet — the app boots fine without a reachable one, since nothing
# queries it until a domain module does.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twitter_challenge?schema=public
