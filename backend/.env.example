# Optional Observability tool (free) generate credentials at: https://www.observe.nestjs.com/
#OBSERVE_APP_KEY
#OBSERVE_APP_SECRET

# Port the API listens on. Leave it set: an empty `PORT=` fails validation
# (the 3000 default only applies when the variable is absent).
PORT=3000

# Runtime environment (development | production | test). NODE_ENV=production
# makes the session cookie `Secure` (sent over HTTPS only).
#NODE_ENV=development

# Exact origin of the frontend (no trailing slash). It is the only origin
# allowed by CORS and by the auth guard's Origin check for state-changing
# requests. Defaults to the Vite dev server.
#FRONTEND_ORIGIN=http://localhost:5173

# SQLite file URL used by Prisma. A relative `file:` path has no inherent
# anchor, so both prisma7.config.ts (used by the CLI for generate/db push/
# etc.) and src/database/prisma.service.ts (used by the app at runtime)
# explicitly resolve it relative to their own module location rather than
# process.cwd(), so they always agree on the same physical file regardless
# of the invocation directory. With the default below, that's
# backend/prisma/dev.db. No server is needed — SQLite is just a local file —
# but the value is still validated as a non-empty string at boot.
DATABASE_URL=file:./dev.db
